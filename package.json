{
  "name": "@designliquido/delegua-llvm",
  "version": "9.1.1",
  "description": "Biblioteca de conversão de código Delégua na representação intermediária de código LLVM.",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "delegua-llvm": "./dist/ilc.js"
  },
  "author": "Leonel Sanches da Silva",
  "license": "MIT",
  "homepage": "https://github.com/DesignLiquido/delegua-llvm#readme",
  "keywords": [
    "delegua"
  ],
  "scripts": {
    "empacotar": "yarn rimraf ./dist && tsc && yarn copyfiles -V ./package.json ./dist && yarn copyfiles -u 1 \"fontes/bibliotecas/**\" ./dist",
    "testes-unitarios": "jest --coverage",
    "executar": "ts-node fontes/ilc.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesignLiquido/delegua-llvm.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@designliquido/delegua": "^1.18.2",
    "@designliquido/delprops": "^0.0.2",
    "@designliquido/llvm-bindings": "^9.1.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
